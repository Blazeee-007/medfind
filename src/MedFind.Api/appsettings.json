{
  "ConnectionStrings": {
    "Default": "Host=postgres;Port=5432;Database=medfind;Username=medfind;Password=medfind"
  },
  "Redis": {
    "Connection": "redis:6379"
  },
  "Jwt": {
    "Key": "${JWT_KEY}",
    "Issuer": "medfind",
    "Audience": "medfind"
  },
  "PharmacyRegistrationCode": "${PHARMACY_CODE}",
  "MEDFIND_STALE_AFTER_MINUTES": "60",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
